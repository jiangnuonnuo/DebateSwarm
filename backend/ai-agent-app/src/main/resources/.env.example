MYSQL_USERNAME=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB_NAME=ai-agent

POSTGRESQL_USERNAME=your_postgresql_user
POSTGRESQL_PASSWORD=your_postgresql_password
POSTGRESQL_DB_NAME=ai-agent

REDIS_DATABASE=0
REDIS_PASSWORD=your_redis_password

OPENAI_BASE_URL=http://localhost:3000
OPENAI_API_KEY=sk-replace-with-api-key

EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SCHEMA_NAME=public
EMBEDDING_TABLE_NAME=vector_store_openai

XHS_PUBLISH_ASSET_BASE_DIR=./runtime/xhs-publish/assets
XHS_PUBLISH_ASSET_ACCESS_BASE_URL=/miniagent/api/v1/xhs/publish/material/access
XHS_PUBLISH_SNAPSHOT_BASE_DIR=./runtime/xhs-publish/snapshots
XHS_PUBLISH_ASSET_RETENTION_HOURS=24
XHS_PUBLISH_SNAPSHOT_RETENTION_HOURS=24
XHS_PUBLISH_DEFAULT_TENANT_ID=default
XHS_PUBLISH_DEFAULT_ACCOUNT_ID=default
XHS_PUBLISH_DEFAULT_ACCOUNT_NAME=default
XHS_PUBLISH_VECTOR_SCHEMA_NAME=public
XHS_PUBLISH_VECTOR_TABLE_NAME=vector_store_xhs_openai
XHS_PUBLISH_ASSET_CLEANUP_CRON=0 0 */1 * * ?
XHS_PUBLISH_SNAPSHOT_CLEANUP_CRON=0 30 */1 * * ?
XHS_PUBLISH_MCP_BASE_URL=http://127.0.0.1:18060
XHS_PUBLISH_MCP_ENDPOINT=/mcp
XHS_PUBLISH_MCP_TIMEOUT_MINUTES=30
XHS_PUBLISH_MCP_POLL_ROUNDS=2
XHS_PUBLISH_MCP_POLL_INTERVAL_MILLIS=1500

